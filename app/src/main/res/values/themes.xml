<resources>
    <style name="Theme.FruitSplash" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#FFB300</item>
        <item name="android:navigationBarColor">#16351D</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.ZestGate" parent="Theme.FruitSplash">
        <item name="android:windowBackground">@color/zest_soil</item>
        <item name="android:statusBarColor">@color/zest_soil</item>
        <item name="android:navigationBarColor">@color/zest_soil</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
